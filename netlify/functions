import { getStore } from '@netlify/blobs';

// Single endpoint for the shared score store.
// GET  /api/store?action=get&key=KEY
// GET  /api/store?action=list&prefix=PREFIX
// POST /api/store  { action:'set', key, value }
// POST /api/store  { action:'del', key }
export default async (req) => {
  const cors = {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET,POST,OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
    'Content-Type': 'application/json',
  };
  if (req.method === 'OPTIONS') return new Response('', { headers: cors });

  const store = getStore('mb-golf-2026');
  const url = new URL(req.url);

  try {
    if (req.method === 'GET') {
      const action = url.searchParams.get('action') || 'get';
      if (action === 'list') {
        const prefix = url.searchParams.get('prefix') || '';
        const { blobs } = await store.list({ prefix });
        const data = {};
        await Promise.all(
          blobs.map(async (b) => {
            data[b.key] = await store.get(b.key, { type: 'json' });
          })
        );
        return new Response(JSON.stringify({ ok: true, data }), { headers: cors });
      }
      const key = url.searchParams.get('key');
      const data = key ? await store.get(key, { type: 'json' }) : null;
      return new Response(JSON.stringify({ ok: true, data }), { headers: cors });
    }

    if (req.method === 'POST') {
      const body = await req.json();
      if (body.action === 'set') {
        await store.setJSON(body.key, body.value);
        return new Response(JSON.stringify({ ok: true }), { headers: cors });
      }
      if (body.action === 'del') {
        await store.delete(body.key);
        return new Response(JSON.stringify({ ok: true }), { headers: cors });
      }
    }
    return new Response(JSON.stringify({ ok: false, error: 'bad request' }), { status: 400, headers: cors });
  } catch (e) {
    return new Response(JSON.stringify({ ok: false, error: String(e) }), { status: 500, headers: cors });
  }
};

export const config = { path: '/api/store' };
